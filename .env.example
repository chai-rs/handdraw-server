# Export settings explicitly; the app and migration script do not load this file.
APP_HTTP_ADDR=127.0.0.1:8081
APP_LOG_TIMEZONE=UTC
APP_LOG_PRETTY_FORMAT=false
# Browser access is disabled until explicit allowed origins are configured.
APP_HTTP_CORS_ENABLED=false
# APP_HTTP_CORS_ALLOW_ORIGINS=http://localhost:5173

# Reserved for the future restricted runtime database connection.
DATABASE_URL=

# Separate privileged connection for golang-migrate, never used by the server.
# URL must include search_path=public&x-migrations-table=handdraw_schema_migrations.
# Set sslmode=verify-full (or the appropriate explicit TLS mode) for remote targets.
MIGRATION_DATABASE_URL=

# Optional identity slice. Enable only after the reviewed target schema/function
# and resolver-only role exist; local Auth fixtures are test-only.
APP_IDENTITY_ENABLED=false
APP_IDENTITY_SUPABASE_URL=
APP_IDENTITY_PUBLISHABLE_KEY=
APP_IDENTITY_AUDIENCE=authenticated
APP_IDENTITY_TIMEOUT=5s
# Dedicated narrow resolver connection, never postgres/service_role/migration DSN.
APP_IDENTITY_DATABASE_URL=

# Optional T03 workspace metadata routes require identity enabled and schema 9.
APP_WORKSPACE_ENABLED=false
# Separate restricted LOGIN inheriting handdraw_request; not the resolver DSN.
APP_WORKSPACE_DATABASE_URL=
# Stable random secret, at least 32 bytes; share across replicas, keep private.
APP_WORKSPACE_CURSOR_KEY=

# Independent Scalar reference, started by make openapi; no database needed.
OPENAPI_ADDR=127.0.0.1:8082

# T04 project/board routes require workspace and identity above.
APP_BOARD_ENABLED=false
# Board DELETE is mounted only when its in-process cleanup worker is enabled.
APP_CLEANUP_ENABLED=false
# Separate function-only LOGIN inheriting handdraw_cleanup_worker.
APP_CLEANUP_DATABASE_URL=

# T05 membership/invitations/Viewer grants require board + workspace + identity.
APP_MEMBERSHIP_ENABLED=false
# Independent random secret, at least 32 bytes; preserve across restarts/replicas.
# Email delivery remains pending integration; no invitation tokens are returned by HTTP.
APP_MEMBERSHIP_TOKEN_KEY=

# T06 durable collaboration requires board + workspace + identity.
# Use direct PostgreSQL/session pooling: transaction pooling cannot hold authority.
APP_COLLABORATION_ENABLED=false
APP_COLLABORATION_ORIGINS=http://127.0.0.1:5175

# T11 billing. Keep local for deterministic development or use Polar sandbox.
APP_BILLING_ENABLED=false
APP_BILLING_DATABASE_URL=
APP_BILLING_PROVIDER=local
APP_BILLING_POLAR_BASE_URL=https://sandbox-api.polar.sh
APP_BILLING_POLAR_ACCESS_TOKEN=
APP_BILLING_POLAR_WEBHOOK_SECRET=
APP_BILLING_POLAR_SUCCESS_URL=http://127.0.0.1:5175/app/cloud?checkout_id={CHECKOUT_ID}
APP_BILLING_POLAR_RETURN_URL=http://127.0.0.1:5175/app/cloud
APP_BILLING_POLAR_CLOUD_MONTHLY_PRODUCT=466beb9c-08f4-4445-9d83-aae610d066ab
APP_BILLING_POLAR_CLOUD_YEARLY_PRODUCT=da67b324-07cd-40d8-8e75-d5221931fe2f
APP_BILLING_POLAR_TEAM_MONTHLY_PRODUCT=6299e9e5-6937-4165-81d0-c1ac2568d7ab
APP_BILLING_POLAR_TEAM_YEARLY_PRODUCT=c20cdaf0-499f-4f04-93fb-b0e7ec958779
APP_BILLING_POLAR_TIMEOUT=10s
